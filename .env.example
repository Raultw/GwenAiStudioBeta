# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string (Neon, Supabase, Render, Cloud SQL, etc.)
# Example: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# EMAIL NOTIFICATION PROVIDER CONFIGURATION
# EMAIL_PROVIDER_MODE: "resend" (default for testing deliveries), "smtp" or "mock"
EMAIL_PROVIDER_MODE=resend
EMAIL_DELIVERY_ENV=test
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Gwen Nails
RESEND_REPLY_TO=
RESEND_ENABLE_REAL_SEND_IN_TEST=false
RESEND_TEST_ALLOWED_RECIPIENTS=
RESEND_TEST_SUBJECT_PREFIX=[TEST Gwen Nails]
RESEND_TEST_TO=

# GMAIL SMTP CONFIGURATION (When EMAIL_PROVIDER_MODE=gmail_smtp)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
GMAIL_FROM_NAME=Gwen Nails
GMAIL_REPLY_TO=
GMAIL_ENABLE_REAL_SEND_IN_TEST=false
GMAIL_TEST_ALLOWED_RECIPIENTS=
GMAIL_TEST_TO=
GMAIL_TEST_SUBJECT_PREFIX=[TEST Gwen Nails]

# SUPERADMIN BOOTSTRAP CONFIGURATION
# Solo para el primer arranque de una base sin ningún superadmin.
# Retirar estas variables después de crear la cuenta.
SUPERADMIN_BOOTSTRAP_USERNAME=
SUPERADMIN_BOOTSTRAP_PASSWORD=
SUPERADMIN_BOOTSTRAP_DISPLAY_NAME=


